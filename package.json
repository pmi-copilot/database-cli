{
    "name": "db-cli",
    "version": "1.0.0",
    "description": "SQL Server CLI with named database profiles",
    "license": "MIT",
    "type": "module",
    "bin": {
        "db-cli": "dist/src/cli/index.js"
    },
    "files": [
        "dist",
        "config/databases.example.json",
        "config/env.example"
    ],
    "scripts": {
        "build": "tsc && shx chmod +x dist/src/cli/index.js",
        "prepare": "npm run build",
        "watch": "tsc --watch",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "mssql": "11.0.1"
    },
    "devDependencies": {
        "@types/mssql": "^9.1.5",
        "rimraf": "^5.0.5",
        "shx": "0.4.0",
        "typescript": "5.8.3"
    }
}
