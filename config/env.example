# SQL Server connection (shared across all profiles)
DB_SERVER=your-sql-server-host
DB_USER=your-username
DB_PASSWORD=your-password
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Database profiles — each DB_<NAME> becomes a named profile
# Add or rename profiles to match your environment
DB_TENANT=TenantDB
DB_GLOBAL=GlobalDB
DB_ADMIN=AdminDB
DB_GOGREEN=GoGreenDB
